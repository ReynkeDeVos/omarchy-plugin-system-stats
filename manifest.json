{
  "schemaVersion": 1,
  "id": "reynkedevos.system-stats",
  "name": "System Stats",
  "version": "0.4.0",
  "author": "Reynke De Vos",
  "description": "Shared CPU and RAM usage with stable GPU selection for the Omarchy bar",
  "license": "MIT",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "System Stats",
    "description": "Shared CPU and RAM usage with stable GPU selection",
    "category": "System",
    "allowMultiple": false,
    "defaults": {
      "intervalSeconds": 2,
      "ramDisplayFormat": "percent",
      "gpuSelection": {
        "mode": "auto",
        "configRevision": 0
      }
    },
    "schema": [
      {
        "key": "intervalSeconds",
        "type": "integer",
        "label": "Sampling interval",
        "description": "Measure every two to ten whole seconds.",
        "min": 2,
        "max": 10,
        "step": 1,
        "defaultValue": 2
      },
      {
        "key": "ramDisplayFormat",
        "type": "enum",
        "label": "RAM display format",
        "description": "Show RAM as a percentage or as used/total IEC GiB.",
        "options": ["percent", "gib"],
        "defaultValue": "percent"
      }
    ],
    "defaultSection": "right"
  }
}
